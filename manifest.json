{
  "manifest_version": 3,
  "name": "Locu",
  "version": "1.0.0",
  "description": "Flaire les loyers trop hauts à Paris : encadrement des loyers et temps de trajet, directement sur les annonces Jinka et Leboncoin.",
  "icons": {
    "16": "assets/icones-extension/icone-16.png",
    "32": "assets/icones-extension/icone-32.png",
    "48": "assets/icones-extension/icone-48.png",
    "128": "assets/icones-extension/icone-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Locu",
    "default_icon": {
      "16": "assets/icones-extension/icone-16.png",
      "32": "assets/icones-extension/icone-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html"
}
